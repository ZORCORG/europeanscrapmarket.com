---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Advertise with us | European Scrap Market"
  description="Advertise on Europe's scrap metal marketplace. Reach scrap yards, industrial sellers, and recyclers across 30+ countries."
>

<div class="mx-auto max-w-3xl px-5 py-12 sm:px-8">
  <p class="mono" data-reveal>ADVERTISING</p>
  <h1 class="display h-section mt-3" data-reveal>Advertise with <span class="grad-text">us</span></h1>
  <p class="mt-4 max-w-xl text-sm text-[var(--color-muted)]" data-reveal>
    Reach scrap yards, industrial sellers, and recyclers across 30+ European countries.
    A limited number of ad placements are available.
  </p>

  <div class="mt-10 grid gap-6 sm:grid-cols-2" data-reveal>
    <div class="rounded-xl border border-[var(--color-line)] bg-white p-6">
      <h2 class="display text-lg font-bold">Main sponsor</h2>
      <p class="mt-2 text-sm text-[var(--color-muted)]">Exclusive placement in the top bar — visible on every page. One slot only.</p>
    </div>
    <div class="rounded-xl border border-[var(--color-line)] bg-white p-6">
      <h2 class="display text-lg font-bold">Marketplace slot</h2>
      <p class="mt-2 text-sm text-[var(--color-muted)]">Sponsored placement on the marketplace page, above the listings grid.</p>
    </div>
  </div>

  <div class="mt-10" data-reveal>
    <a href="/contact/" class="btn btn-accent">Contact us about advertising <span class="arrow">→</span></a>
  </div>
</div>

</Layout>
