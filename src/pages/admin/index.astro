---
import Layout from '../../layouts/Layout.astro';

const title = 'Admin dashboard | European Scrap Market';
const description = 'Admin control panel for European Scrap Market.';
---

<Layout {title} {description} noindex={true}>
  <div id="auth-check" class="mx-auto max-w-6xl px-5 py-12">
    <div class="text-center">
      <div class="inline-block animate-spin h-8 w-8 border-2 border-[var(--color-accent)] border-t-transparent rounded-full"></div>
      <p class="mt-3 text-sm text-[var(--color-faint)]">Loading admin panel…</p>
    </div>
  </div>

  <div id="admin-content" class="hidden mx-auto max-w-6xl px-5 py-12">
    <!-- Admin nav -->
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <h1 class="font-display text-2xl font-bold text-[var(--color-ink)]">Admin panel</h1>
        <p class="text-sm text-[var(--color-faint)]">European Scrap Market — control centre</p>
      </div>
      <div class="flex items-center gap-3">
        <a href="/account" class="text-sm text-[var(--color-faint)] hover:text-[var(--color-ink)]">My account</a>
        <button id="signout-btn" class="text-sm text-[var(--color-accent)] hover:underline">Sign out</button>
      </div>
    </div>

    <!-- Tabs -->
    <nav class="mt-6 flex flex-wrap gap-1 border-b border-[var(--color-line)]">
      <a href="#" data-tab="dashboard" class="admin-tab active px-4 py-2 text-sm font-medium">Dashboard</a>
      <a href="#" data-tab="leads" class="admin-tab px-4 py-2 text-sm font-medium">Leads</a>
      <a href="#" data-tab="partners" class="admin-tab px-4 py-2 text-sm font-medium">Partners</a>
      <a href="#" data-tab="users" class="admin-tab px-4 py-2 text-sm font-medium">Users</a>
    </nav>

    <!-- Dashboard tab -->
    <div id="tab-dashboard" class="admin-panel mt-6">
      <div id="stats-grid" class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
        <div class="border border-[var(--color-line)] bg-white p-4">
          <p class="mono text-xs text-[var(--color-faint)]">TOTAL LEADS</p>
          <p id="stat-leads" class="mt-1 font-display text-2xl font-bold">—</p>
        </div>
        <div class="border border-[var(--color-line)] bg-white p-4">
          <p class="mono text-xs text-[var(--color-faint)]">NEW LEADS</p>
          <p id="stat-new-leads" class="mt-1 font-display text-2xl font-bold text-[var(--color-accent)]">—</p>
        </div>
        <div class="border border-[var(--color-line)] bg-white p-4">
          <p class="mono text-xs text-[var(--color-faint)]">PARTNERS</p>
          <p id="stat-partners" class="mt-1 font-display text-2xl font-bold">—</p>
        </div>
        <div class="border border-[var(--color-line)] bg-white p-4">
          <p class="mono text-xs text-[var(--color-faint)]">PENDING</p>
          <p id="stat-pending" class="mt-1 font-display text-2xl font-bold text-[var(--color-accent)]">—</p>
        </div>
        <div class="border border-[var(--color-line)] bg-white p-4">
          <p class="mono text-xs text-[var(--color-faint)]">USERS</p>
          <p id="stat-users" class="mt-1 font-display text-2xl font-bold">—</p>
        </div>
        <div class="border border-[var(--color-line)] bg-white p-4">
          <p class="mono text-xs text-[var(--color-faint)]">LISTINGS</p>
          <p id="stat-listings" class="mt-1 font-display text-2xl font-bold">—</p>
        </div>
      </div>

      <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-2">
        <div class="border border-[var(--color-line)] bg-white p-6">
          <h2 class="mono text-xs text-[var(--color-faint)]">LEADS BY COUNTRY</h2>
          <div id="country-stats" class="mt-4 space-y-2"></div>
        </div>
        <div class="border border-[var(--color-line)] bg-white p-6">
          <h2 class="mono text-xs text-[var(--color-faint)]">RECENT LEADS</h2>
          <div id="recent-leads" class="mt-4 space-y-3"></div>
        </div>
      </div>
    </div>

    <!-- Leads tab -->
    <div id="tab-leads" class="admin-panel mt-6 hidden">
      <div class="flex items-center gap-3">
        <select id="lead-filter" class="border border-[var(--color-line-strong)] bg-white px-3 py-2 text-sm">
          <option value="new">New</option>
          <option value="contacted">Contacted</option>
          <option value="completed">Completed</option>
          <option value="archived">Archived</option>
        </select>
      </div>
      <div id="leads-table" class="mt-4 overflow-x-auto"></div>
    </div>

    <!-- Partners tab -->
    <div id="tab-partners" class="admin-panel mt-6 hidden">
      <div class="flex items-center gap-3">
        <select id="partner-filter" class="border border-[var(--color-line-strong)] bg-white px-3 py-2 text-sm">
          <option value="pending">Pending</option>
          <option value="approved">Approved</option>
          <option value="rejected">Rejected</option>
        </select>
      </div>
      <div id="partners-table" class="mt-4 overflow-x-auto"></div>
    </div>

    <!-- Users tab -->
    <div id="tab-users" class="admin-panel mt-6 hidden">
      <div id="users-table" class="overflow-x-auto"></div>
    </div>
  </div>
</Layout>

<script>
  import { getSession, signOut } from '../../lib/auth-client';
  import { fetchAdminStats, fetchLeads, updateLeadStatus, fetchPartners, updatePartnerStatus, fetchUsers, updateUser } from '../../lib/api';

  const authCheck = document.getElementById('auth-check')!;
  const content = document.getElementById('admin-content')!;

  (async () => {
    const user = await getSession();
    if (!user) {
      window.location.href = '/login?redirect=/admin';
      return;
    }
    if (user.role !== 'admin') {
      window.location.href = '/account';
      return;
    }

    authCheck.classList.add('hidden');
    content.classList.remove('hidden');

    // Sign out
    document.getElementById('signout-btn')?.addEventListener('click', () => signOut());

    // Tab switching
    document.querySelectorAll('.admin-tab').forEach(tab => {
      tab.addEventListener('click', (e) => {
        e.preventDefault();
        document.querySelectorAll('.admin-tab').forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.admin-panel').forEach(p => p.classList.add('hidden'));
        tab.classList.add('active');
        document.getElementById('tab-' + (tab as HTMLElement).dataset.tab)?.classList.remove('hidden');
      });
    });

    // Load dashboard
    try {
      const data = await fetchAdminStats();
      (document.getElementById('stat-leads') as HTMLElement).textContent = String(data.stats.totalLeads ?? 0);
      (document.getElementById('stat-new-leads') as HTMLElement).textContent = String(data.stats.newLeads ?? 0);
      (document.getElementById('stat-partners') as HTMLElement).textContent = String(data.stats.totalPartners ?? 0);
      (document.getElementById('stat-pending') as HTMLElement).textContent = String(data.stats.pendingPartners ?? 0);
      (document.getElementById('stat-users') as HTMLElement).textContent = String(data.stats.totalUsers ?? 0);
      (document.getElementById('stat-listings') as HTMLElement).textContent = String(data.stats.activeListings ?? 0);

      const countryStats = document.getElementById('country-stats')!;
      if (data.leadsByCountry?.length) {
        const max = Math.max(...data.leadsByCountry.map((c: any) => c.count));
        countryStats.innerHTML = data.leadsByCountry.map((c: any) =>
          `<div class="flex items-center gap-3">
            <span class="w-24 truncate text-sm">${c.country}</span>
            <div class="flex-1 h-2 bg-[var(--color-bg)] rounded-full overflow-hidden">
              <div class="h-full bg-[var(--color-accent)] rounded-full" style="width:${(c.count / max * 100)}%"></div>
            </div>
            <span class="text-sm font-medium w-8 text-right">${c.count}</span>
          </div>`
        ).join('');
      } else {
        countryStats.innerHTML = '<p class="text-sm text-[var(--color-faint)]">No leads yet.</p>';
      }

      const recentLeads = document.getElementById('recent-leads')!;
      if (data.recentLeads?.length) {
        recentLeads.innerHTML = data.recentLeads.map((l: any) =>
          `<div class="flex items-center justify-between border-b border-[var(--color-line)] pb-2">
            <div>
              <p class="text-sm font-medium">${l.name} · ${l.country}</p>
              <p class="text-xs text-[var(--color-faint)]">${l.scrap_class || 'Mixed'}</p>
            </div>
            <span class="text-xs text-[var(--color-faint)]">${new Date(l.created_at).toLocaleDateString()}</span>
          </div>`
        ).join('');
      } else {
        recentLeads.innerHTML = '<p class="text-sm text-[var(--color-faint)]">No recent leads.</p>';
      }
    } catch {
      // D1 not set up yet — show zeros
    }

    // Load leads
    async function loadLeads() {
      const status = (document.getElementById('lead-filter') as HTMLSelectElement).value;
      const table = document.getElementById('leads-table')!;
      try {
        const leads = await fetchLeads(status);
        if (!leads.length) { table.innerHTML = '<p class="text-sm text-[var(--color-faint)]">No leads found.</p>'; return; }
        table.innerHTML = `<table class="w-full text-sm">
          <thead><tr class="border-b border-[var(--color-line)] text-left">
            <th class="py-2 pr-4">Name</th><th class="py-2 pr-4">Country</th><th class="py-2 pr-4">Scrap class</th>
            <th class="py-2 pr-4">Date</th><th class="py-2 pr-4">Status</th><th class="py-2"></th>
          </tr></thead>
          <tbody>${leads.map((l: any) =>
            `<tr class="border-b border-[var(--color-line)]">
              <td class="py-2 pr-4">${l.name}<br><span class="text-xs text-[var(--color-faint)]">${l.email}</span></td>
              <td class="py-2 pr-4">${l.country}</td>
              <td class="py-2 pr-4">${l.scrap_class || '—'}</td>
              <td class="py-2 pr-4">${new Date(l.created_at).toLocaleDateString()}</td>
              <td class="py-2 pr-4"><span class="text-xs font-medium">${l.status}</span></td>
              <td class="py-2">
                <select data-lead-id="${l.id}" class="lead-status-sel border border-[var(--color-line)] bg-white px-2 py-1 text-xs">
                  <option value="new" ${l.status === 'new' ? 'selected' : ''}>New</option>
                  <option value="contacted" ${l.status === 'contacted' ? 'selected' : ''}>Contacted</option>
                  <option value="completed" ${l.status === 'completed' ? 'selected' : ''}>Completed</option>
                  <option value="archived" ${l.status === 'archived' ? 'selected' : ''}>Archived</option>
                </select>
              </td>
            </tr>`
          ).join('')}</tbody></table>`;

        table.querySelectorAll('.lead-status-sel').forEach(sel => {
          sel.addEventListener('change', async (e) => {
            const id = (e.target as HTMLSelectElement).dataset.leadId;
            const status = (e.target as HTMLSelectElement).value;
            await updateLeadStatus(id!, status);
            loadLeads();
          });
        });
      } catch {
        table.innerHTML = '<p class="text-sm text-[var(--color-faint)]">Unable to load leads. Database may not be configured.</p>';
      }
    }

    document.getElementById('lead-filter')?.addEventListener('change', loadLeads);
    loadLeads();

    // Load partners
    async function loadPartners() {
      const status = (document.getElementById('partner-filter') as HTMLSelectElement).value;
      const table = document.getElementById('partners-table')!;
      try {
        const partners = await fetchPartners(status);
        if (!partners.length) { table.innerHTML = '<p class="text-sm text-[var(--color-faint)]">No applications found.</p>'; return; }
        table.innerHTML = `<table class="w-full text-sm">
          <thead><tr class="border-b border-[var(--color-line)] text-left">
            <th class="py-2 pr-4">Company</th><th class="py-2 pr-4">Contact</th><th class="py-2 pr-4">Country</th>
            <th class="py-2 pr-4">Date</th><th class="py-2 pr-4">Status</th><th class="py-2"></th>
          </tr></thead>
          <tbody>${partners.map((p: any) =>
            `<tr class="border-b border-[var(--color-line)]">
              <td class="py-2 pr-4">${p.company_name}</td>
              <td class="py-2 pr-4">${p.contact_name}<br><span class="text-xs text-[var(--color-faint)]">${p.email}</span></td>
              <td class="py-2 pr-4">${p.country}</td>
              <td class="py-2 pr-4">${new Date(p.created_at).toLocaleDateString()}</td>
              <td class="py-2 pr-4"><span class="text-xs font-medium">${p.status}</span></td>
              <td class="py-2 flex gap-1">
                <button data-partner-id="${p.id}" data-action="approved" class="partner-act border border-green-600 px-2 py-1 text-xs text-green-700 hover:bg-green-50">Approve</button>
                <button data-partner-id="${p.id}" data-action="rejected" class="partner-act border border-red-400 px-2 py-1 text-xs text-red-600 hover:bg-red-50">Reject</button>
              </td>
            </tr>`
          ).join('')}</tbody></table>`;

        table.querySelectorAll('.partner-act').forEach(btn => {
          btn.addEventListener('click', async (e) => {
            const id = (e.target as HTMLButtonElement).dataset.partnerId;
            const action = (e.target as HTMLButtonElement).dataset.action;
            await updatePartnerStatus(id!, action!);
            loadPartners();
          });
        });
      } catch {
        table.innerHTML = '<p class="text-sm text-[var(--color-faint)]">Unable to load partners. Database may not be configured.</p>';
      }
    }

    document.getElementById('partner-filter')?.addEventListener('change', loadPartners);
    loadPartners();

    // Load users
    async function loadUsers() {
      const table = document.getElementById('users-table')!;
      try {
        const users = await fetchUsers();
        if (!users.length) { table.innerHTML = '<p class="text-sm text-[var(--color-faint)]">No users found.</p>'; return; }
        table.innerHTML = `<table class="w-full text-sm">
          <thead><tr class="border-b border-[var(--color-line)] text-left">
            <th class="py-2 pr-4">Name</th><th class="py-2 pr-4">Email</th><th class="py-2 pr-4">Role</th>
            <th class="py-2 pr-4">Status</th><th class="py-2 pr-4">Joined</th>
          </tr></thead>
          <tbody>${users.map((u: any) =>
            `<tr class="border-b border-[var(--color-line)]">
              <td class="py-2 pr-4">${u.name || '—'}</td>
              <td class="py-2 pr-4">${u.email}</td>
              <td class="py-2 pr-4">
                <select data-user-id="${u.id}" data-field="role" class="user-update border border-[var(--color-line)] bg-white px-2 py-1 text-xs">
                  <option value="buyer" ${u.role === 'buyer' ? 'selected' : ''}>Buyer</option>
                  <option value="partner" ${u.role === 'partner' ? 'selected' : ''}>Partner</option>
                  <option value="admin" ${u.role === 'admin' ? 'selected' : ''}>Admin</option>
                </select>
              </td>
              <td class="py-2 pr-4">
                <select data-user-id="${u.id}" data-field="status" class="user-update border border-[var(--color-line)] bg-white px-2 py-1 text-xs">
                  <option value="active" ${u.status === 'active' ? 'selected' : ''}>Active</option>
                  <option value="suspended" ${u.status === 'suspended' ? 'selected' : ''}>Suspended</option>
                  <option value="pending" ${u.status === 'pending' ? 'selected' : ''}>Pending</option>
                </select>
              </td>
              <td class="py-2 pr-4 text-xs text-[var(--color-faint)]">${new Date(u.created_at).toLocaleDateString()}</td>
            </tr>`
          ).join('')}</tbody></table>`;

        table.querySelectorAll('.user-update').forEach(sel => {
          sel.addEventListener('change', async (e) => {
            const id = (e.target as HTMLSelectElement).dataset.userId;
            const field = (e.target as HTMLSelectElement).dataset.field;
            const value = (e.target as HTMLSelectElement).value;
            await updateUser(id!, { [field!]: value });
          });
        });
      } catch {
        table.innerHTML = '<p class="text-sm text-[var(--color-faint)]">Unable to load users. Database may not be configured.</p>';
      }
    }

    loadUsers();
  })();
</script>

<style>
  .admin-tab.active {
    border-bottom: 2px solid var(--color-accent);
    color: var(--color-accent);
  }
</style>
