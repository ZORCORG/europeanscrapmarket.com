---
import Layout from '../../layouts/Layout.astro';
import AdSlot from '../../components/AdSlot.astro';
import { countries, scrapClasses } from '../../data/countries';

const sortedCountries = [...countries].sort((a, b) => a.name.localeCompare(b.name));

const title = 'Scrap metal marketplace — browse listings | European Scrap Market';
const description = 'Browse scrap metal listings from verified yards across Europe. Filter by country and material type.';
---

<Layout {title} {description}>

<div class="mx-auto max-w-7xl px-5 pt-6 text-sm text-[var(--color-faint)] sm:px-8">
  <a href="/" class="hover:text-[var(--color-accent)]">Home</a>
  <span class="mx-2">/</span>
  <span class="text-[var(--color-ink)]">Marketplace</span>
</div>

<section class="mx-auto max-w-7xl px-5 py-12 sm:px-8">
  <p class="mono" data-reveal>MARKETPLACE</p>
  <h1 class="display h-section mt-3" data-reveal>Scrap metal <span class="grad-text">listings</span></h1>
  <p class="mt-4 max-w-xl text-sm text-[var(--color-muted)]" data-reveal>
    Browse available scrap from verified yards across Europe. Filter by country or material, then contact the yard directly.
  </p>

  <!-- Filters -->
  <div class="mt-8 flex flex-wrap gap-3" data-reveal>
    <select id="filter-country" class="border border-[var(--color-line-strong)] bg-white px-3 py-2 text-sm outline-none focus:border-[var(--color-accent)]">
      <option value="">All countries</option>
      {sortedCountries.map(c => <option value={c.name}>{c.name}</option>)}
    </select>
    <select id="filter-class" class="border border-[var(--color-line-strong)] bg-white px-3 py-2 text-sm outline-none focus:border-[var(--color-accent)]">
      <option value="">All materials</option>
      {scrapClasses.map(s => <option value={s.name}>{s.name}</option>)}
    </select>
    <button id="filter-apply" class="btn btn-primary">Filter</button>
    <button id="filter-clear" class="text-sm text-[var(--color-accent)] hover:underline self-center">Clear</button>
  </div>

  <div id="marketplace-listings" class="mt-8">
    <p class="text-sm text-[var(--color-faint)]">Loading…</p>
  </div>

  <div class="mt-12" data-reveal>
    <AdSlot slot="marketplace-bottom" />
  </div>
</section>

</Layout>

<script>
  const container = document.getElementById('marketplace-listings')!;
  let currentCountry = '';
  let currentClass = '';

  async function loadListings() {
    container.innerHTML = '<p class="text-sm text-[var(--color-faint)]">Loading…</p>';

    const params = new URLSearchParams();
    if (currentCountry) params.set('country', currentCountry);
    if (currentClass) params.set('scrapClass', currentClass);

    try {
      const res = await fetch(`/api/marketplace?${params.toString()}`);
      const data = await res.json();
      const listings = data.listings || [];

      if (!listings.length) {
        container.innerHTML = `
          <div class="border border-[var(--color-line)] bg-white p-12 text-center">
            <p class="text-sm text-[var(--color-muted)]">No listings match your filters right now.</p>
            <p class="mt-2 text-sm text-[var(--color-faint)]">New listings appear as verified yards publish them. You can also <a href="/submit/" class="text-[var(--color-accent)] hover:underline">submit your own scrap request</a> to get bids.</p>
          </div>
        `;
        return;
      }

      container.innerHTML = `
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          ${listings.map((l: any) => `
            <div class="tcard p-5">
              <div class="flex items-start justify-between">
                <span class="mono text-xs text-[var(--color-accent)]">${l.scrap_class || 'Mixed'}</span>
                ${l.source === 'partner_ad' ? '<span class="mono text-xs text-green-600">VERIFIED</span>' : ''}
              </div>
              <h3 class="display mt-2 text-base font-bold">${l.title || 'Untitled'}</h3>
              <p class="mt-1 text-xs text-[var(--color-faint)]">${l.country || '—'}${l.city ? ' · ' + l.city : ''}</p>
              ${l.weight_kg ? `<p class="mt-2 text-sm text-[var(--color-muted)]">${l.weight_kg.toLocaleString()} kg</p>` : ''}
              ${l.price_eur ? `<p class="mt-1 text-sm font-bold text-[var(--color-ink)]">€${Number(l.price_eur).toLocaleString()}</p>` : ''}
              ${l.description ? `<p class="mt-2 text-xs text-[var(--color-muted)] line-clamp-2">${l.description}</p>` : ''}
              <p class="mt-3 text-xs text-[var(--color-faint)]">${new Date(l.created_at).toLocaleDateString('en-GB')}</p>
            </div>
          `).join('')}
        </div>
        <p class="mt-6 text-center text-xs text-[var(--color-faint)]">${data.total} listing${data.total !== 1 ? 's' : ''}</p>
      `;
    } catch {
      container.innerHTML = '<p class="text-sm text-[var(--color-faint)]">Unable to load listings. Please try again.</p>';
    }
  }

  document.getElementById('filter-apply')?.addEventListener('click', () => {
    currentCountry = (document.getElementById('filter-country') as HTMLSelectElement).value;
    currentClass = (document.getElementById('filter-class') as HTMLSelectElement).value;
    loadListings();
  });

  document.getElementById('filter-clear')?.addEventListener('click', () => {
    (document.getElementById('filter-country') as HTMLSelectElement).value = '';
    (document.getElementById('filter-class') as HTMLSelectElement).value = '';
    currentCountry = '';
    currentClass = '';
    loadListings();
  });

  loadListings();
</script>

<style>
  :global(.line-clamp-2) {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
