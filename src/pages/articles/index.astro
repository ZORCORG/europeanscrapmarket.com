---
import Layout from '../../layouts/Layout.astro';
import { articles } from '../../data/articles';
---

<Layout
  title="Knowledge base — scrap metal guides | European Scrap Market"
  description="Guides on selling scrap metal in Europe. How to compare yards, get the best price, sort for better value, and safe trading practices."
>

<div class="mx-auto max-w-7xl px-5 pt-6 text-sm text-[var(--color-faint)] sm:px-8">
  <a href="/" class="hover:text-[var(--color-accent)]">Home</a>
  <span class="mx-2">/</span>
  <span class="text-[var(--color-ink)]">Articles</span>
</div>

<section class="mx-auto max-w-7xl px-5 py-12 sm:px-8">
  <p class="mono" data-reveal>KNOWLEDGE BASE</p>
  <h1 class="display h-section mt-3" data-reveal>Guides & <span class="grad-text">knowledge</span></h1>
  <p class="mt-4 max-w-xl text-sm text-[var(--color-muted)]" data-reveal>
    Practical guides on selling scrap metal across Europe — from first-time sellers to industrial volumes.
  </p>

  <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {articles.map(a => (
      <a href={`/articles/${a.slug}/`} class="tcard p-6" data-reveal>
        <p class="mono text-[var(--color-faint)]">{a.date}</p>
        <h2 class="display mt-3 text-base font-bold">{a.title}</h2>
        <p class="mt-2 text-sm text-[var(--color-muted)]">{a.excerpt}</p>
        <div class="mt-4 flex items-center justify-between">
          <p class="text-sm font-bold text-[var(--color-accent)]">Read more →</p>
          <span class="text-xs text-[var(--color-faint)]">{a.readTime} min</span>
        </div>
      </a>
    ))}
  </div>
</section>

</Layout>
