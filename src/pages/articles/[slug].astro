---
import Layout from '../../layouts/Layout.astro';
import { articles } from '../../data/articles';

export function getStaticPaths() {
  return articles.map(a => ({
    params: { slug: a.slug },
    props: { article: a },
  }));
}

const { article } = Astro.props;

// Find related articles (exclude current, take first 3)
const related = articles.filter(a => a.slug !== article.slug).slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description: article.excerpt,
  datePublished: article.date,
  author: { '@type': 'Organization', name: 'European Scrap Market' },
  publisher: {
    '@type': 'Organization',
    name: 'European Scrap Market',
    url: 'https://europeanscrapmarket.com',
  },
  mainEntityOfPage: `https://europeanscrapmarket.com/articles/${article.slug}/`,
};
---

<Layout
  title={`${article.title} | European Scrap Market`}
  description={article.excerpt}
  jsonLd={jsonLd}
>

<div class="mx-auto max-w-7xl px-5 pt-6 text-sm text-[var(--color-faint)] sm:px-8">
  <a href="/" class="hover:text-[var(--color-accent)]">Home</a>
  <span class="mx-2">/</span>
  <a href="/articles/" class="hover:text-[var(--color-accent)]">Articles</a>
  <span class="mx-2">/</span>
  <span class="text-[var(--color-ink)]">{article.title}</span>
</div>

<article class="mx-auto max-w-3xl px-5 py-12 sm:px-8">
  <p class="mono" data-reveal>KNOWLEDGE BASE</p>
  <h1 class="display h-section mt-3" data-reveal>{article.title}</h1>
  <div class="mt-3 flex items-center gap-3 text-sm text-[var(--color-faint)]" data-reveal>
    <time datetime={article.date}>{new Date(article.date).toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
    <span>·</span>
    <span>{article.readTime} min read</span>
  </div>

  <div class="article-body mt-8 text-sm leading-relaxed text-[var(--color-muted)]" set:html={article.body} data-reveal></div>

  <!-- CTA -->
  <div class="mt-12 rounded-xl border border-[var(--color-accent)] bg-[var(--color-bg)] p-6" data-reveal>
    <h2 class="display text-lg font-bold text-[var(--color-ink)]">Ready to sell your scrap?</h2>
    <p class="mt-2 text-sm text-[var(--color-muted)]">Submit your scrap in 30 seconds. Verified yards in your country bid for your material. Free for sellers, no obligation.</p>
    <a href="/submit/" class="btn btn-accent mt-4 inline-block">Submit your scrap <span class="arrow">→</span></a>
  </div>

  <!-- Related articles -->
  <div class="mt-12">
    <h2 class="mono text-xs text-[var(--color-faint)]">RELATED ARTICLES</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-3">
      {related.map(r => (
        <a href={`/articles/${r.slug}/`} class="tcard p-4">
          <h3 class="display text-sm font-bold">{r.title}</h3>
          <p class="mt-1 text-xs text-[var(--color-muted)] line-clamp-2">{r.excerpt}</p>
          <p class="mt-3 text-xs font-bold text-[var(--color-accent)]">Read →</p>
        </a>
      ))}
    </div>
  </div>
</article>

</Layout>

<style>
  .article-body :global(h2) {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-ink);
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }
  .article-body :global(p) {
    margin-bottom: 0.75rem;
  }
  .article-body :global(ul) {
    margin-bottom: 0.75rem;
    padding-left: 1.25rem;
  }
  .article-body :global(li) {
    margin-bottom: 0.25rem;
  }
  .article-body :global(strong) {
    color: var(--color-ink);
    font-weight: 600;
  }
  :global(.line-clamp-2) {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
