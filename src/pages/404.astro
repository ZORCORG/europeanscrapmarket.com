---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page not found (404) | European Scrap Market"
  description="The page you were looking for does not exist. Find your way via the marketplace, country pages, or homepage."
  noindex
>

<div class="mx-auto max-w-2xl px-5 py-24 text-center sm:px-8">
  <p class="mono" data-reveal>404</p>
  <h1 class="display h-section mt-4" data-reveal>Page not <span class="grad-text">found</span></h1>
  <p class="mt-4 text-sm text-[var(--color-muted)]" data-reveal>
    The page you were looking for does not exist. Try one of these:
  </p>
  <div class="mt-8 flex flex-wrap justify-center gap-3" data-reveal>
    <a href="/" class="btn btn-accent">Homepage →</a>
    <a href="/marketplace/" class="btn btn-ghost">Marketplace</a>
    <a href="/sell-scrap/" class="btn btn-ghost">Sell scrap</a>
  </div>
</div>

</Layout>
