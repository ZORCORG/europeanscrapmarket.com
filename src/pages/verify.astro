---
import Layout from '../layouts/Layout.astro';

const title = 'Verifying… | European Scrap Market';
const description = 'Verifying your sign-in link.';
---

<Layout {title} {description} noindex={true}>
  <section class="mx-auto max-w-md px-5 py-20 text-center">
    <div class="inline-block animate-spin h-8 w-8 border-2 border-[var(--color-accent)] border-t-transparent rounded-full"></div>
    <h1 class="mt-4 font-display text-xl text-[var(--color-ink)]">Verifying your sign-in link…</h1>
    <p id="status" class="mt-2 text-sm text-[var(--color-faint)]">Please wait.</p>
  </section>
</Layout>

<script>
  const status = document.getElementById('status')!;
  const token = new URLSearchParams(window.location.search).get('token');

  if (!token) {
    status.textContent = 'No token found. Please request a new sign-in link.';
    status.classList.add('text-red-600');
  } else {
    // The Worker will redirect on success. If we're still here, it failed.
    // Trigger the verify endpoint via fetch to handle it client-side.
    fetch(`/api/auth/verify?token=${encodeURIComponent(token)}`, { redirect: 'manual' })
      .then(async (res) => {
        if (res.status === 302) {
          window.location.href = '/account';
        } else {
          const data = await res.json().catch(() => ({}));
          status.textContent = data.error || 'Invalid or expired link.';
          status.classList.add('text-red-600');
        }
      })
      .catch(() => {
        status.textContent = 'Something went wrong. Please try again.';
        status.classList.add('text-red-600');
      });
  }
</script>
