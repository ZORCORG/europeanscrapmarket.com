---
import { countries, scrapClasses } from '../data/countries';
const majorCountries = ['germany', 'france', 'italy', 'spain', 'united-kingdom', 'netherlands', 'poland', 'sweden'];
const footerCountries = countries.filter(c => majorCountries.includes(c.slug));
---

<footer class="mt-24 border-t border-[var(--color-line)] bg-[var(--color-ink)] text-white/80">
  <div class="mx-auto max-w-7xl px-5 py-16 sm:px-8">
    <div class="grid gap-12 lg:grid-cols-4">
      <!-- Brand -->
      <div>
        <span class="display text-lg font-bold text-white">
          European<span class="text-[var(--color-accent)]">Scrap</span>Market
        </span>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-white/60">
          Europe's marketplace for metal scrap. Submit your scrap — a verified yard in your country picks it up and contacts you. Free for sellers.
        </p>
      </div>

      <!-- Sell scrap -->
      <div>
        <p class="mono mb-3 text-white/40">SELL SCRAP</p>
        <div class="space-y-2">
          <a href="/submit/" class="block text-sm text-white/80 hover:text-[var(--color-accent)]">Submit a request</a>
          <a href="/marketplace/" class="block text-sm text-white/80 hover:text-[var(--color-accent)]">Marketplace</a>
          <a href="/scrap-prices/" class="block text-sm text-white/80 hover:text-[var(--color-accent)]">Scrap prices</a>
          <a href="/scrap-classes/" class="block text-sm text-white/80 hover:text-[var(--color-accent)]">Scrap classes</a>
          <a href="/sell-scrap/" class="block text-sm text-white/80 hover:text-[var(--color-accent)]">All countries</a>
        </div>
      </div>

      <!-- For yards -->
      <div>
        <p class="mono mb-3 text-white/40">FOR SCRAP YARDS</p>
        <div class="space-y-2">
          <a href="/become-partner" class="block text-sm text-white/80 hover:text-[var(--color-accent)]">Become a partner</a>
          <a href="/pricing/" class="block text-sm text-white/80 hover:text-[var(--color-accent)]">Pricing plans</a>
          <a href="/trust/" class="block text-sm text-white/80 hover:text-[var(--color-accent)]">Trust & verification</a>
          <a href="/partner-terms" class="block text-sm text-white/80 hover:text-[var(--color-accent)]">Partner terms</a>
          <a href="/advertise/" class="block text-sm text-white/80 hover:text-[var(--color-accent)]">Advertise</a>
        </div>
      </div>

      <!-- Major countries -->
      <div>
        <p class="mono mb-3 text-white/40">POPULAR COUNTRY PAGES</p>
        <div class="space-y-2">
          {footerCountries.map(c => (
            <a href={`/sell-scrap/${c.slug}/`} class="block text-sm text-white/80 hover:text-[var(--color-accent)]">
              Sell scrap in {c.name}
            </a>
          ))}
          <a href="/sell-scrap/" class="block text-sm font-bold text-[var(--color-accent)]">All {countries.length} countries →</a>
        </div>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-4 border-t border-white/10 pt-6 text-xs text-white/40 sm:flex-row sm:items-center sm:justify-between">
      <p>© {new Date().getFullYear()} European Scrap Market. All rights reserved.</p>
      <div class="flex flex-wrap gap-x-6 gap-y-2">
        <a href="/contact/" class="hover:text-white">Contact</a>
        <a href="/privacy/" class="hover:text-white">Privacy</a>
        <a href="/terms/" class="hover:text-white">Terms</a>
        <a href="/partner-terms" class="hover:text-white">Partner terms</a>
      </div>
    </div>
  </div>
</footer>
