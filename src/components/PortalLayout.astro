---
// Shared layout for the partner portal — sidebar nav + auth gate
import Layout from '../layouts/Layout.astro';

export interface Props {
  title?: string;
  description?: string;
  active?: string;
}

const { title = 'Portal', description = 'Partner portal', active = '' } = Astro.props;

const navItems = [
  { slug: 'dashboard', label: 'Overview', href: '/portal', icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6' },
  { slug: 'leads', label: 'Leads', href: '/portal/leads', icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2' },
  { slug: 'profile', label: 'Yard profile', href: '/portal/profile', icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4' },
  { slug: 'prices', label: 'Price book', href: '/portal/prices', icon: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.595 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.595-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z' },
  { slug: 'zones', label: 'Zones', href: '/portal/zones', icon: 'M17.657 16.657L13.414 20.9a1.994 1.994 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z' },
  { slug: 'ads', label: 'My listings', href: '/portal/ads', icon: 'M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z' },
  { slug: 'billing', label: 'Billing', href: '/portal/billing', icon: 'M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H5a3 3 0 00-3 3v8a3 3 0 003 3z' },
  { slug: 'settings', label: 'Settings', href: '/portal/settings', icon: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z' },
];
---

<Layout {title} {description} noindex={true}>
  <div id="portal-gate" class="min-h-[60vh] flex items-center justify-center">
    <div class="text-center">
      <div class="inline-block animate-spin h-8 w-8 border-2 border-[var(--color-accent)] border-t-transparent rounded-full"></div>
      <p class="mt-3 text-sm text-[var(--color-faint)]">Loading portal…</p>
    </div>
  </div>

  <div id="portal-app" class="hidden mx-auto max-w-7xl px-5 py-8">
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-[220px_1fr]">
      <!-- Sidebar -->
      <aside class="lg:sticky lg:top-20 lg:h-fit">
        <div class="flex items-center justify-between lg:block">
          <div class="mb-4">
            <a href="/portal" class="font-display text-lg font-bold text-[var(--color-ink)]">Portal</a>
            <p class="mono text-[10px] text-[var(--color-faint)]">PARTNER AREA</p>
          </div>
          <button id="mobile-nav-toggle" class="lg:hidden text-sm text-[var(--color-accent)]">Menu</button>
        </div>

        <nav id="portal-nav" class="hidden lg:block space-y-1">
          {navItems.map(item => (
            <a
              href={item.href}
              class:list={[
                'flex items-center gap-2 rounded px-3 py-2 text-sm transition-colors',
                active === item.slug
                  ? 'bg-[var(--color-accent)] text-white font-medium'
                  : 'text-[var(--color-ink)] hover:bg-[var(--color-bg)]'
              ]}
            >
              <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
              </svg>
              {item.label}
            </a>
          ))}
          <div class="my-3 border-t border-[var(--color-line)]"></div>
          <a href="/" class="flex items-center gap-2 rounded px-3 py-2 text-sm text-[var(--color-faint)] hover:bg-[var(--color-bg)]">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
            Back to site
          </a>
          <button id="portal-signout" class="w-full flex items-center gap-2 rounded px-3 py-2 text-sm text-red-600 hover:bg-red-50">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" /></svg>
            Sign out
          </button>
        </nav>
      </aside>

      <!-- Main content -->
      <main class="min-w-0">
        <slot />
      </main>
    </div>
  </div>
</Layout>

<script>
  import { getSession, signOut } from '../lib/auth-client';

  const gate = document.getElementById('portal-gate')!;
  const app = document.getElementById('portal-app')!;

  (async () => {
    const user = await getSession();
    if (!user) {
      window.location.href = '/login?redirect=' + encodeURIComponent(window.location.pathname);
      return;
    }
    if (user.role !== 'partner' && user.role !== 'admin') {
      window.location.href = '/account';
      return;
    }
    gate.classList.add('hidden');
    app.classList.remove('hidden');

    // Mobile nav toggle
    document.getElementById('mobile-nav-toggle')?.addEventListener('click', () => {
      document.getElementById('portal-nav')?.classList.toggle('hidden');
    });

    // Sign out
    document.getElementById('portal-signout')?.addEventListener('click', () => signOut());
  })();
</script>
